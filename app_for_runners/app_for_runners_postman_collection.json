      "name": "Swagger (public)",
      "item": [
        {
          "name": "GET /swagger.json",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"openapi version is 3.0.3\", function () {",
                  "  pm.expect(data.openapi).to.eql(\"3.0.3\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/swagger.json",
              "host": ["localhost"],
              "port": "5000",
              "path": ["swagger.json"]
            }
          },
