# Локальный запуск без Docker (только Postgres в контейнере):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/app_for_runners

# Docker Compose (сервис api подключается к хосту db:5432 внутри сети compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app_for_runners

# Redis — очередь Socket.IO между инстансами API (обязательно при scale > 1)
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production
CORS_ALLOWED_ORIGINS=*

# Production tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO
# Swagger UI (/docs) — только для dev/staging
ENABLE_SWAGGER=false

# JWT: допуск при проверке exp (сек). Увеличьте при сильном рассинхроне часов сервера.
JWT_LEEWAY_SECONDS=900
JWT_REFRESH_GRACE_DAYS=30

# Web Client ID из Google Cloud Console (OAuth 2.0 Client IDs -> Web application)
# Для Android также добавьте SHA-1 отпечаток в OAuth client типа Android.
GOOGLE_CLIENT_IDS=393960878436-jdf4trd7ivbkjni7e3eqv9ibpei01700.apps.googleusercontent.com
